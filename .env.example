# Copy this file to .env and adjust values as needed.

# PostgreSQL
POSTGRES_DB=library
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# Postgres HA cluster (repmgr + pgpool)
# Superuser password shared by both pg-0/pg-1 and used by pgpool for admin ops.
POSTGRES_ADMIN_PASSWORD=change-me-admin
# Password repmgr uses internally between pg-0 and pg-1 for replication management.
REPMGR_PASSWORD=change-me-repmgr
# Login for pgpool's own admin/monitoring interface (pcp).
PGPOOL_ADMIN_PASSWORD=change-me-pgpool

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Backup container (pg-backup) -> ghi .dump ra thu muc tren may that Windows qua SMB.
# Tren Windows: chia se thu muc C:\Users\doant\OneDrive\Documents\Desktop\pg-backups
#   voi Share name = pg-backups, cap Change + Read cho user SMB_USERNAME.
WIN_HOST_IP=192.168.1.10
SMB_USERNAME=pgbackup
SMB_PASSWORD=change-me-smb

# Django backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# React frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
