# Copy this file to .env and adjust values as needed.

# PostgreSQL
POSTGRES_DB=library
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# Postgres HA cluster (repmgr + pgpool)
# Superuser password shared by all pg nodes and used by pgpool for admin ops.
POSTGRES_ADMIN_PASSWORD=change-me-admin
# Password repmgr uses internally between the pg nodes for replication management.
REPMGR_PASSWORD=change-me-repmgr
# Login for pgpool's own admin/monitoring interface (pcp).
PGPOOL_ADMIN_PASSWORD=change-me-pgpool

# HA tách 3 máy — IP tĩnh của từng VM. Dùng cho docker-compose{,.pg0,.pg1}.yml.
#   VM1 = app + pgpool + pg-witness   (docker-compose.yml)
#   VM2 = pg-0                        (docker-compose.pg0.yml)
#   VM3 = pg-1                        (docker-compose.pg1.yml)
# Cùng 1 file .env này được copy sang cả 3 VM.
VM1_IP=192.168.111.136
VM2_IP=192.168.111.140
VM3_IP=192.168.111.142

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Backup container (pg-backup) -> ghi .dump ra thu muc tren may that Windows qua SMB.
# Tren Windows: chia se thu muc C:\Users\doant\OneDrive\Documents\Desktop\pg-backups
#   voi Share name = pg-backups, cap Change + Read cho user SMB_USERNAME.
WIN_HOST_IP=192.168.1.10
SMB_USERNAME=pgbackup
SMB_PASSWORD=change-me-smb

# Django backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Phải có VM1_IP: từ khi có nginx (deploy/nginx/nginx.conf) đứng trước, trình
# duyệt gọi thẳng http://<VM1_IP>/..., Django thấy Host header = VM1_IP và từ
# chối nếu không có trong danh sách này (lỗi "DisallowedHost").
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.111.136
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.111.136

# React frontend
# Rỗng = gọi API theo đường dẫn tương đối (/api/...), đi qua nginx cùng origin
# với trang - không cần CORS cho đường này nữa. Đổi giá trị này phải rebuild
# frontend (NEXT_PUBLIC_* được build cứng vào bundle lúc build, không đọc lại
# lúc chạy): docker compose build frontend && docker compose up -d frontend.
NEXT_PUBLIC_API_URL=

# Logging stack (elasticsearch/kibana/filebeat) - see deploy/LOGGING.md
ELASTIC_PASSWORD=change-me-elastic
KIBANA_PASSWORD=change-me-kibana
# >=32 ký tự ngẫu nhiên, sinh 1 lần: `openssl rand -hex 32`
KIBANA_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
